# --- Database (Neon / Vercel Postgres / Supabase). Use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth: long random string (openssl rand -base64 48)
AUTH_SECRET=""

# --- Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://archaiccandles.com"

# --- First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@archaiccandles.com"
ADMIN_PASSWORD=""

# --- Razorpay (optional) https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Cashfree (optional) https://merchant.cashfree.com > Developers > API Keys
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# "production" or "sandbox"
CASHFREE_ENV="production"

# --- Image uploads: Vercel Blob read/write token (Vercel > Storage > Blob)
BLOB_READ_WRITE_TOKEN=""

# --- Transactional email (optional) https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Archaic Candles <orders@archaiccandles.com>"

# --- Search engine verification (optional): paste only the content value of the meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
